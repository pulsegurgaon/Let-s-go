# --- API KEYS ---
# Get your key from https://console.groq.com/
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GPU SERVER SETTINGS ---
# The URL where your FastAPI app will be accessible
LOCAL_GPU_URL=http://0.0.0.0:8000

# --- STORAGE SETTINGS ---
# Absolute or relative path where the .mp4 files will be saved
OUTPUT_PATH=./outputs

# --- MODEL SETTINGS ---
# Default model for the worker (e.g., Lightricks/LTX-Video or others)
MODEL_ID=Lightricks/LTX-Video
